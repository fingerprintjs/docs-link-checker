// Fallow: unused code and dependencies (`pnpm run dead-code`), risky changes in a PR diff (`pnpm run check:diff`).
// Rules: https://fallow.tools/docs
{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": ["src/__fixtures__/**"],
  "rulePacks": ["fallow-rules.jsonc"],
  // Report exports of entry files too (bin, scripts, bench), not only of imported modules
  "includeEntryExports": true,
  "failOnParseError": true,
  "rules": {
    // Default is warn or off, which doesn't fail CI
    "unused-dev-dependencies": "error",
    "unused-namespace-members": "error",
    "unused-component-props": "error",
    "unlisted-binaries": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "duplicate-export-aliases": "error",
    "re-export-cycle": "error",
    "deprecated-exports-in-use": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "policy-violation": "error",

    // PR diff only (`fallow audit`). Agents tend to skip a failing test or special-case tests in source code.
    "weakened-tests": "error",
    "test-only-branch": "error",
    // Often legitimate (a library over own code, a suppression with a reason), so shown, not failed
    "added-suppression": "warn",
    "added-dependency": "warn",
  },
  // Folder imports go one way: shared <- run <- github <- check <- sources <- cli. report needs only shared.
  // Imports into a file outside every zone are not checked, so each folder under src/ has a zone.
  "boundaries": {
    "zones": [
      { "name": "report", "patterns": ["src/report/**"] },
      {
        "name": "shared",
        "patterns": [
          "src/types.ts",
          "src/terminal.ts",
          "src/baseline.ts",
          "src/glob.ts",
          "src/utils/**",
        ],
      },
      {
        "name": "run",
        "patterns": ["src/run.ts", "src/run.test.ts", "src/parallel.ts", "src/parallel.test.ts"],
      },
      { "name": "github", "patterns": ["src/github/**"] },
      { "name": "check", "patterns": ["src/check/**"] },
      { "name": "sources", "patterns": ["src/sources/**"] },
      // Entry point, may import every zone, so it has no rule
      { "name": "cli", "patterns": ["src/cli.ts"] },
    ],
    "rules": [
      // Rendering reports needs only results and shared helpers, never the code that finds or checks links
      { "from": "report", "allow": ["shared"] },
      // Plain helpers and data types, usable from anywhere, so they depend on nothing else in src/
      { "from": "shared", "allow": [] },
      // Every check and source reads the run context (terminal, caches, limiters), so it can't depend on them.
      // `RunDeps` names the GitHub client type for test fakes, a type import only.
      { "from": "run", "allow": ["shared"], "allowTypeOnly": ["github"] },
      // GitHub API client and URL helpers, used by both the GitHub link check and the github-org source
      { "from": "github", "allow": ["run", "shared"] },
      // Checking a link doesn't depend on where the link was found
      { "from": "check", "allow": ["github", "run", "shared"] },
      // Sources collect links, then check them
      { "from": "sources", "allow": ["check", "github", "run", "shared"] },
    ],
  },
  "audit": {
    // Judge the whole changed files, without analyzing the base branch: `dead-code` already requires zero findings,
    // and the base branch may lack files this config needs (a new rule pack)
    "gate": "all",
    // oxlint (sonarjs) already limits complexity
    "health": false,
    "dupes": false,
  },
}
