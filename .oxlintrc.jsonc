{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "vitest",
    "react"
  ],
  "jsPlugins": ["eslint-plugin-sonarjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [".claude/**", "results/**", "src/__fixtures__/**"],
  "rules": {
    // Keep functions readable. Cognitive complexity covers what a line limit would catch, without pushing
    // code into thin helpers (see CODING_STANDARDS.md)
    "sonarjs/cognitive-complexity": ["error", 20],
    "max-depth": ["error", 4],
    "max-params": ["error", 4],
    "max-nested-callbacks": ["error", 4],

    // Async mistakes (a forgotten `await` is the most common one)
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/return-await": ["error", "in-try-catch"],
    "no-async-promise-executor": "error",

    // Type safety: no `any` leaks, no silenced type errors
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": "allow-with-description" }],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-deprecated": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-base-to-string": "error",
    // `||` on strings is fine: an empty environment variable means "not set"
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true } }],
    "typescript/prefer-optional-chain": "error",
    "typescript/consistent-type-imports": ["error", { "disallowTypeAnnotations": false }],
    "typescript/no-unnecessary-condition": "error",

    // Errors keep their cause, nothing is swallowed silently
    "preserve-caught-error": "error",
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "unicorn/prefer-type-error": "error",

    // Structure
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "no-shadow": "error",
    "eqeqeq": "error",
    "no-nested-ternary": "error",
    "no-param-reassign": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-else-return": "error",
    "no-console": "off",
    // Sequential awaits are deliberate here (retries, rate limits, shared browser)
    "no-await-in-loop": "off",
    // Covered by `noImplicitReturns` in tsconfig.json, which understands exhaustive switches
    "typescript/consistent-return": "off",

    // Tests: no skipped, focused or empty tests
    "vitest/no-disabled-tests": "error",
    "vitest/no-focused-tests": "error",
    "vitest/expect-expect": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-conditional-expect": "error",
    "vitest/no-standalone-expect": "error",
    // `expect(value, message)` is valid in Vitest
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "vitest/valid-title": ["error", { "ignoreTypeOfDescribeName": true }],
    "vitest/no-duplicate-hooks": "error",

    // False positives in this codebase
    "unicorn/no-array-callback-reference": "off",
    "unicorn/consistent-function-scoping": "off",
    // The new JSX transform (`"jsx": "react-jsx"`) does not need React in scope
    "react/react-in-jsx-scope": "off",
    "vitest/require-mock-type-parameters": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test_setup.ts"],
      "rules": {
        "max-nested-callbacks": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/require-await": "off",
        "typescript/no-unsafe-type-assertion": "off",
        // False positives on `{} as Record<...>` initial values of test state
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-base-to-string": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "sonarjs/cognitive-complexity": "off"
      }
    }
  ]
}
