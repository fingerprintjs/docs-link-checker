{
  "name": "docs-link-checker",
  "version": "1.0.0",
  "description": "Checks links, including hash anchors, in Fingerprint docs, public GitHub READMEs and fingerprint.com",
  "private": true,
  "type": "module",
  "bin": {
    "docs-link-checker": "./bin/docs-link-checker.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "cli": "node bin/docs-link-checker.js",
    "bench": "tsx bench/bench.ts",
    "checkLinks:docs": "node bin/docs-link-checker.js site https://dev.fingerprint.com --baseline linkcheck.baseline.json",
    "checkLinks:github": "node bin/docs-link-checker.js github-org fingerprintjs --baseline linkcheck.baseline.json",
    "checkLinks:web": "node bin/docs-link-checker.js site https://fingerprint.com --include https://dev.fingerprint.com --include https://fingerprint.com --include https://github.com --baseline linkcheck.baseline.json",
    "checkLinks:files": "node bin/docs-link-checker.js files README.md",
    "tsc": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "pnpm run format:check && pnpm run lint && pnpm run tsc && pnpm run knip",
    "check:fix": "oxfmt && oxlint --fix",
    "gh-limit": "tsx ./checks/gh_rate_limit.ts"
  },
  "keywords": [],
  "author": "Juraj Uhlar, Fingerprint",
  "license": "ISC",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "p-limit": "^7.3.3",
    "playwright": "^1.63.0",
    "preact": "^11.0.0",
    "preact-render-to-string": "^6.8.0",
    "tsx": "^4.23.15",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "knip": "6.39.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
