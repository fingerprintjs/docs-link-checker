{
  "name": "docs-link-checker",
  "version": "1.0.0",
  "description": "Checks links, including hash anchors, in Fingerprint docs, public GitHub READMEs and fingerprint.com",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "checkLinks:docs": "tsx ./checks/docs.ts",
    "checkLinks:github": "tsx ./checks/github.ts",
    "checkLinks:web": "tsx ./checks/web.ts",
    "tsc": "tsc --noEmit",
    "gh-limit": "tsx ./checks/gh_rate_limit.ts"
  },
  "keywords": [],
  "author": "Juraj Uhlar, Fingerprint",
  "license": "ISC",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@supercharge/promise-pool": "^3.3.0",
    "cheerio": "^1.2.0",
    "cli-progress": "^3.12.0",
    "dotenv": "^18.0.4",
    "github-slugger": "^2.0.0",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@octokit/types": "^18.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
