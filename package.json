{
  "name": "docs-link-checker",
  "version": "1.0.0",
  "description": "Checks links, including hash anchors, in Fingerprint docs, public GitHub READMEs and fingerprint.com",
  "private": true,
  "type": "module",
  "bin": {
    "docs-link-checker": "./bin/docs-link-checker.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "cli": "tsx src/cli.ts",
    "checkLinks:docs": "tsx src/cli.ts site https://dev.fingerprint.com --baseline linkcheck.baseline.json",
    "checkLinks:github": "tsx src/cli.ts github-org fingerprintjs --baseline linkcheck.baseline.json",
    "checkLinks:web": "tsx src/cli.ts site https://fingerprint.com --include https://dev.fingerprint.com --include https://fingerprint.com --include https://github.com --baseline linkcheck.baseline.json",
    "checkLinks:files": "tsx src/cli.ts files README.md",
    "tsc": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "gh-limit": "tsx ./checks/gh_rate_limit.ts"
  },
  "keywords": [],
  "author": "Juraj Uhlar, Fingerprint",
  "license": "ISC",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@supercharge/promise-pool": "^3.3.0",
    "cheerio": "^1.2.0",
    "cli-progress": "^3.12.0",
    "dotenv": "^18.0.4",
    "github-slugger": "^2.0.0",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@octokit/types": "^18.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
